# Contratto di embedding della KB (DEVE coincidere col runtime di binocolo).
# Cambiare il modello qui = ri-embeddare i documenti con un modello diverso
# dalle query del runtime -> coseno-spazzatura silenzioso. Il modello DEVE
# esistere in mrsmith.embedding_model (migration 058); la dimensione viene
# verificata contro quella registrata.
EMBEDDING_API_BASE=https://api.fireworks.ai/inference/v1
EMBEDDING_API_KEY=fw-your-key-here
EMBEDDING_MODEL=accounts/fireworks/models/qwen3-embedding-8b
# Postgres Anisetta (schemi mrsmith + binocolo). Il loader scrive qui.
DATABASE_URL=postgres://user:pass@host:5432/anisetta?sslmode=require
